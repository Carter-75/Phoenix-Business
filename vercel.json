{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "app.js"
    }
  },
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist/frontend",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/custom-websites", "destination": "/services/custom-websites", "permanent": true },
    { "source": "/custom-website-development", "destination": "/services/custom-websites", "permanent": true },
    { "source": "/automation", "destination": "/services/automation", "permanent": true },
    { "source": "/ai-solutions", "destination": "/services/ai-solutions", "permanent": true },
    { "source": "/ai-web-development", "destination": "/services/ai-web-development", "permanent": true },
    { "source": "/ai-development", "destination": "/services/ai-web-development", "permanent": true },
    { "source": "/full-stack-development", "destination": "/services/full-stack-development", "permanent": true },
    { "source": "/full-stack", "destination": "/services/full-stack-development", "permanent": true },
    { "source": "/data", "destination": "/data-cleanup", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    
    { "source": "/", "destination": "/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/ai-web-development", "destination": "/services/ai-web-development/index.html" },
    { "source": "/services/full-stack-development", "destination": "/services/full-stack-development/index.html" },
    { "source": "/services/custom-websites", "destination": "/services/custom-websites/index.html" },
    { "source": "/services/automation", "destination": "/services/automation/index.html" },
    { "source": "/services/ai-solutions", "destination": "/services/ai-solutions/index.html" },
    { "source": "/data-cleanup", "destination": "/data-cleanup/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/reviews", "destination": "/reviews/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/refunds", "destination": "/refunds/index.html" },
    
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/checkout-success", "destination": "/index.html" },
    { "source": "/growth-crm", "destination": "/index.html" },
    { "source": "/admin-reviews", "destination": "/index.html" },
    { "source": "/leave-review", "destination": "/index.html" },
    { "source": "/leave-review/:token", "destination": "/index.html" },
    { "source": "/data/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|png|jpg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/check-refunds", "schedule": "0 12 * * *" },
    { "path": "/api/cron/daily-renewals", "schedule": "0 8 * * *" }
  ]
}

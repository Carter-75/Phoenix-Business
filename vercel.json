{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "app.js"
    }
  },
  "routes": [
    { "src": "^/api(/.*)?$", "dest": "/api$1" },
    
    { "src": "^/home$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/custom-websites$", "status": 308, "headers": { "Location": "/services/custom-websites" } },
    { "src": "^/custom-website-development$", "status": 308, "headers": { "Location": "/services/custom-websites" } },
    { "src": "^/automation$", "status": 308, "headers": { "Location": "/services/automation" } },
    { "src": "^/ai-solutions$", "status": 308, "headers": { "Location": "/services/ai-solutions" } },
    { "src": "^/ai-web-development$", "status": 308, "headers": { "Location": "/services/ai-web-development" } },
    { "src": "^/ai-development$", "status": 308, "headers": { "Location": "/services/ai-web-development" } },
    { "src": "^/full-stack-development$", "status": 308, "headers": { "Location": "/services/full-stack-development" } },
    { "src": "^/full-stack$", "status": 308, "headers": { "Location": "/services/full-stack-development" } },
    { "src": "^/data$", "status": 308, "headers": { "Location": "/data-cleanup" } },
    
    { "handle": "filesystem" },
    
    { "src": "^/$", "dest": { "service": "frontend" } },
    { "src": "^/services$", "dest": { "service": "frontend" } },
    { "src": "^/services/ai-web-development$", "dest": { "service": "frontend" } },
    { "src": "^/services/full-stack-development$", "dest": { "service": "frontend" } },
    { "src": "^/services/custom-websites$", "dest": { "service": "frontend" } },
    { "src": "^/services/automation$", "dest": { "service": "frontend" } },
    { "src": "^/services/ai-solutions$", "dest": { "service": "frontend" } },
    { "src": "^/data-cleanup$", "dest": { "service": "frontend" } },
    { "src": "^/about$", "dest": { "service": "frontend" } },
    { "src": "^/reviews$", "dest": { "service": "frontend" } },
    { "src": "^/terms$", "dest": { "service": "frontend" } },
    { "src": "^/privacy$", "dest": { "service": "frontend" } },
    { "src": "^/refunds$", "dest": { "service": "frontend" } },
    
    { "src": "^/dashboard$", "dest": { "service": "frontend" } },
    { "src": "^/checkout$", "dest": { "service": "frontend" } },
    { "src": "^/checkout-success$", "dest": { "service": "frontend" } },
    { "src": "^/growth-crm$", "dest": { "service": "frontend" } },
    { "src": "^/admin-reviews$", "dest": { "service": "frontend" } },
    { "src": "^/leave-review$", "dest": { "service": "frontend" } },
    { "src": "^/leave-review/[^/]+$", "dest": { "service": "frontend" } },
    { "src": "^/data/[^/]+$", "dest": { "service": "frontend" } },
    
    { "src": "/(.*)", "dest": "/api/404" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|png|jpg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/check-refunds", "schedule": "0 12 * * *" },
    { "path": "/api/cron/daily-renewals", "schedule": "0 8 * * *" }
  ]
}

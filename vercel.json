{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "app.js"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-refunds",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/daily-renewals",
      "schedule": "0 8 * * *"
    }
  ]
}